# Public edge for SKF Skill Studio (runs as the `caddy` service in infra/compose.prod.yaml).
#
#   https://{$SKF_DOMAIN}/          -> web (Next.js; it proxies browser calls to the API server-side)
#   https://{$SKF_DOMAIN}/ingest/*  -> api (the only public API path: training jobs phone home with per-stage tokens)
#
# The internal API (/api/v1, /docs, /openapi.json) is never routed from the internet.
# Caddy obtains and renews the certificate itself; ports 80 and 443 must be open to the world.
# No ACME contact email is configured: Caddy renews certificates itself. To get Let's Encrypt expiry notices,
# add a global options block with `email you@example.com` at the top of this file.

{$SKF_DOMAIN} {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
		-X-Powered-By
	}

	# Baseline CSP, applied only when the web app doesn't send its own (the `?` prefix).
	# Presigned artifact URLs (videos, images) are served straight from the S3 bucket origin.
	header ?Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: {$S3_ASSET_ORIGIN}; media-src 'self' blob: {$S3_ASSET_ORIGIN}; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

	@internal_api path /api/v1 /api/v1/* /docs /docs/* /redoc /redoc/* /openapi.json /healthz /readyz
	handle @internal_api {
		respond 404
	}

	handle /ingest/* {
		# SPEC §9.2: a log batch is at most 1 MB.
		request_body {
			max_size 2MB
		}
		reverse_proxy api:8000
	}

	handle {
		# SSE log streams go through here; flush immediately instead of buffering.
		reverse_proxy web:3000 {
			flush_interval -1
		}
	}
}
