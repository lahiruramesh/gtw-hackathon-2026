# Secrets for the containerised stack (`make up` = infra/compose.yaml --profile app). Copy to `.env`.
# Host-run development (`make api`, `make worker`, `make web`) reads apps/api/.env and apps/web/.env.local instead.
# Everything else (database, redis, S3, ports) is wired in infra/compose.yaml.

# Fernet key derivation for compute-target secrets + HMAC for ingest tokens. Generate: openssl rand -base64 32
SECRET_KEY=

# Better Auth session/JWT signing secret, at least 32 characters. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# First admin, created by `make seed` (idempotent). Password: at least 12 characters.
ADMIN_EMAIL=admin@skf.example
ADMIN_PASSWORD=
# ADMIN_NAME=Administrator

# Public URL of /ingest/v1 that Kaggle and AWS jobs post logs to. Empty = remote jobs don't phone home and
# the worker polls their logs instead (local_cpu jobs always use the in-network api).
PUBLIC_INGEST_URL=
