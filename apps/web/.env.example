# Web settings for host-run development (`make web`). Copy to apps/web/.env.local.

# Plain postgres URL (Better Auth keeps its tables in the `auth` schema).
DATABASE_URL=postgresql://skf:skf@localhost:55432/skf

# At least 32 characters. Generate: openssl rand -base64 32. Rotating it signs everyone out.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100

# FastAPI, called server-side only; the browser never sees this origin.
API_INTERNAL_URL=http://localhost:8000

# JWT claims the API verifies; must match apps/api/.env.
AUTH_ISSUER=skf-skill-studio
AUTH_AUDIENCE=skf-api

# First admin, used only by `pnpm seed:admin` (make seed). Password: at least 12 characters.
ADMIN_EMAIL=admin@skf.example
ADMIN_PASSWORD=
# ADMIN_NAME=Administrator
