# API + worker settings for host-run development (`make api`, `make worker`). Copy to apps/api/.env.
# Every variable is documented in docs/webapp/SPEC.md §3; defaults match infra/compose.yaml.

ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://skf:skf@localhost:55432/skf
REDIS_URL=redis://localhost:56379/0

# Better Auth (the web app) publishes its JWKS; issuer and audience must match apps/web/.env.local.
AUTH_JWKS_URL=http://localhost:3100/api/auth/jwks
AUTH_ISSUER=skf-skill-studio
AUTH_AUDIENCE=skf-api

# 32+ random bytes, base64. Generate: openssl rand -base64 32
# Encrypts compute-target secrets: changing it makes stored secrets unreadable (see RUNBOOK, "Rotating secrets").
SECRET_KEY=

# Artifact storage. In dev: the MinIO/RustFS container. On AWS: leave endpoint and keys empty (instance role).
S3_ENDPOINT_URL=http://localhost:59000
S3_PUBLIC_ENDPOINT_URL=http://localhost:59000
S3_BUCKET=skf-artifacts
S3_REGION=eu-north-1
S3_ACCESS_KEY_ID=skfminio
S3_SECRET_ACCESS_KEY=skfminio-dev-secret

# Empty: Kaggle/AWS jobs don't phone home and the worker polls their logs. Local jobs use INTERNAL_INGEST_URL.
PUBLIC_INGEST_URL=
INTERNAL_INGEST_URL=http://localhost:8000/ingest/v1

# The research pipeline the worker runs (defaults: this repo, its .venv from `uv sync --extra train`, .skf-work/).
# PIPELINE_REPO_DIR=
# PIPELINE_PYTHON=
# WORK_DIR=

LOG_MAX_LINES_PER_RUN=200000
